# Hospital Intelligence — Python agent (carpeta agent/ dentro de Susana-AI)
# Copia a agent/.env — NO subir al repo

APP_ENV=development
DEBUG=true

# Misma clave que AGENT_API_KEY en el .env de Node (Node → Python)
AGENT_API_KEY=
# Fallback para demo /flujo (rutas legacy)
INTERNAL_API_KEY=change-me-internal-key

# Callback Python → Node (puerto interno)
NODE_INTERNAL_URL=http://127.0.0.1:3001
# Misma clave que INTERNAL_API_KEY en el .env de Node
NODE_INTERNAL_API_KEY=

# OpenRouter = lenguaje natural del chat (tiempo real)
# NO usar :batch aquí: es API asíncrona (barata pero lenta / no apta para demo en vivo).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-6-luna-pro
# Reasoning "pro" puede tardar un poco más; dejar margen bajo AGENT_TIMEOUT_MS≈20–30s
LLM_TIMEOUT_SECONDS=16
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2
LLM_ENABLED=true
