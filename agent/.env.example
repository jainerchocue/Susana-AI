# Hospital Intelligence — agente Python (agent/)
# Copia a agent/.env — NO subir al repo

APP_ENV=development
DEBUG=false

# Misma clave que AGENT_API_KEY en el .env de Node (Node → Python, cabecera X-Internal-Key)
AGENT_API_KEY=

# Callback Python → Node (puerto interno)
NODE_INTERNAL_URL=http://127.0.0.1:3001
# Misma clave que INTERNAL_API_KEY en el .env de Node
NODE_INTERNAL_API_KEY=

# OpenRouter (opcional): planificador de respaldo y redacción natural en tiempo real.
# Sin clave o con LLM_ENABLED=false el agente responde igual, con redacción determinista.
# NO usar :batch aquí: es API asíncrona (barata pero lenta / no apta para demo en vivo).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-6-luna-pro
# Un modelo de razonamiento tarda más: el pulido tiene su propio tope (LLM_POLISH_TIMEOUT_SECONDS)
# y todo cabe en ASK_BUDGET_SECONDS, por debajo de AGENT_TIMEOUT_MS de Node.
LLM_TIMEOUT_SECONDS=16
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2
LLM_ENABLED=true
# Reescritura natural de la respuesta verificada (se descarta si cambia alguna cifra)
LLM_POLISH=true
LLM_POLISH_TIMEOUT_SECONDS=6

# Presupuesto total por pregunta: por debajo de AGENT_TIMEOUT_MS de Node (20 s)
ASK_BUDGET_SECONDS=17
