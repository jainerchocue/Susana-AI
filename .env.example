# ═══════════════════════════════════════════════════════════════════════════
# Los secretos van VACÍOS a propósito: un placeholder que pasa la validación
# se despliega en silencio; un campo vacío falla ruidosamente al arrancar.
# ═══════════════════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
# Orígenes permitidos por CORS, separados por coma. En producción solo https.
# También son los `trustedOrigins` de Better Auth: valida contra esta lista el
# Origin (CSRF) y todo callbackURL/redirectTo, así que un valor de más aquí es
# un open redirect.
CORS_ORIGINS=http://localhost:5173
# URL pública del frontend (enlaces de los correos)
APP_URL=http://localhost:5173
# URL pública de esta API. Es el baseURL de Better Auth.
API_URL=http://localhost:3000
LOG_LEVEL=info
# false | número de saltos de proxy | lista de CIDR separada por coma.
# Detrás de CDN + balanceador suelen ser 2. Un valor incorrecto rompe el
# rate limit por IP: o bloquea a todos, o no bloquea a nadie.
TRUST_PROXY=false

# ─── Base de datos ──────────────────────────────────────────────────────────
# connection_limit por instancia: N réplicas × este valor debe caber en el
# max_connections de PostgreSQL. Con más de 10 réplicas, usa PgBouncer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plantilla?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=5

# ─── Redis ──────────────────────────────────────────────────────────────────
# OBLIGATORIA en producción: sin ella el rate limit es por proceso y no
# protege nada con más de una instancia. También es el almacén secundario de
# sesiones de Better Auth.
REDIS_URL=redis://localhost:6379

# ─── HTTP ───────────────────────────────────────────────────────────────────
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
# Debe superar el idle timeout del balanceador (normalmente 60s) o aparecen
# 502 esporádicos imposibles de depurar.
HTTP_KEEPALIVE_TIMEOUT_MS=65000
BODY_LIMIT=256kb

# ─── Better Auth ────────────────────────────────────────────────────────────
# Firma las cookies de sesión y cifra el secreto TOTP.
# Genéralo con: openssl rand -base64 48
# Mínimo 48 caracteres y 16 símbolos distintos en producción.
BETTER_AUTH_SECRET=
# Duración de una sesión. Better Auth no usa refresh tokens rotativos: renueva
# la propia sesión cada SESSION_UPDATE_AGE_HOURS mientras se use.
SESSION_TTL_DAYS=7
SESSION_UPDATE_AGE_HOURS=24
# Ventana en la que una sesión se considera "fresca" para acciones sensibles.
SESSION_FRESH_AGE_MINUTES=60
# Caché de sesión en cookie cifrada, propia de Better Auth. `authenticate`
# (core/middleware/authenticate.ts) pide `disableCookieCache: true` en cada
# petición, así que ninguna ruta de nuestra API (todo salvo /auth/**) usa esta
# caché ni sufre su desfase: revocar una sesión corta en el acto. Solo afecta a
# quien llame directamente a GET {API_PREFIX}/auth/get-session sin pedir
# disableCookieCache=true. 0 la desactiva del todo (siempre consulta la BD).
SESSION_COOKIE_CACHE_SECONDS=60

# ─── Cookies ────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false
# strict = frontend y API en el mismo dominio registrable.
# none    = despliegue multi-dominio; exige COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# ─── Seguridad ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Techo por IP en el borde, delante del handler de Better Auth.
AUTH_RATE_LIMIT_MAX=20
# Límites por endpoint de Better Auth, por IP y ventana.
AUTH_SIGNIN_MAX=5
AUTH_SIGNUP_MAX=3
# Intentos de segundo factor. 6 dígitos son 10^6: esto es lo que lo hace útil.
AUTH_MFA_MAX=5
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_VERIFIED_EMAIL=true
# Consulta a HaveIBeenPwned (k-anonimato: solo 5 chars del SHA-1) al registrar
# y al cambiar contraseña.
# OJO: falla CERRADO. Si su API no responde, esas dos rutas devuelven 500.
# Ponla en false si no hay salida a internet; queda el filtro local de
# contraseñas comunes como suelo.
PASSWORD_BREACH_CHECK=true
# Hashes scrypt simultáneos. Por encima se responde 503 en vez de congelar el
# threadpool de libuv, que comparten fs y DNS.
PASSWORD_HASH_CONCURRENCY=4
# TTL de la caché de permisos. 0 la desactiva (siempre consulta la BD).
RBAC_CACHE_TTL_SECONDS=300
# Nombre que muestra la app autenticadora (Google Authenticator, 1Password...).
MFA_ISSUER=Plantilla
# Purga de sesiones y verificaciones caducadas. Con >3 réplicas, ponla en
# false y llama a `npm run db:purge` desde un cron externo.
PURGE_ENABLED=true
PURGE_INTERVAL_MINUTES=60
PURGE_RETENTION_DAYS=7

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Para activar el envio real:
#   1. MAIL_ENABLED=true.
#   2. RESEND_API_KEY= la de https://resend.com/api-keys (obligatoria si MAIL_ENABLED=true).
#   3. Sin dominio propio verificado en Resend, la cuenta esta en modo sandbox:
#      solo puede enviar con `from = onboarding@resend.dev` y UNICAMENTE a la
#      direccion de correo de la propia cuenta de Resend. Para probar flujos
#      de correo (verificacion, bienvenida, alertas) en ese modo, pon
#      SEED_DIRECTOR_EMAIL / SEED_FARMACIA_EMAIL a esa misma direccion.
#   4. Para enviar a cualquier destinatario, verifica un dominio propio en
#      Resend (SPF + DKIM) y usa MAIL_FROM_EMAIL con el.
MAIL_ENABLED=true
# https://resend.com/api-keys
RESEND_API_KEY=
MAIL_FROM_NAME=Hospital Intelligence
# El dominio debe estar verificado en Resend (SPF + DKIM).
MAIL_FROM_EMAIL=no-reply@plantilla.dev
MAIL_REPLY_TO=

# ─── Seed inicial ───────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@plantilla.dev
SEED_ADMIN_PASSWORD=

# ─── Usuarios de prueba (seed) ───────────────────────────────────────────────
# Crea (idempotente, verificados) un DIRECTOR y una FARMACIA de prueba. En
# produccion DEBE ser false: env.ts falla al arrancar si no lo es.
SEED_TEST_USERS=true
# Minimo 12 caracteres. Prohibida en produccion (env.ts la rechaza si es esta).
SEED_TEST_PASSWORD=Prueba123!Hospital
# Con Resend en modo sandbox (ver arriba), pon aqui la direccion de tu cuenta
# de Resend para poder probar los correos reales de estas dos cuentas.
SEED_DIRECTOR_EMAIL=director@hospital.test
SEED_FARMACIA_EMAIL=farmacia@hospital.test

# ─── Registro publico ───────────────────────────────────────────────────────
# Un hospital no tiene autoregistro: por defecto POST /auth/sign-up/email
# responde 403 y las altas las hace un administrador con POST /users.
AUTH_PUBLIC_SIGNUP=false

# ─── Agente IA (Python) ─────────────────────────────────────────────────────
# Sin AGENT_URL, POST /assistant/query responde 503: el asistente no esta
# disponible, pero el resto de la API sigue sirviendo con normalidad.
AGENT_URL=
# Node -> Python, en la cabecera X-Internal-Key de POST {AGENT_URL}/v1/ask.
# Minimo 32 caracteres. Distinta de INTERNAL_API_KEY: filtrar una no permite
# el sentido contrario.
AGENT_API_KEY=
# Python -> Node, en la cabecera X-Internal-Key de POST /internal/agent/query.
# Sin ella el puerto interno NO arranca (cierra en fallo).
INTERNAL_API_KEY=
AGENT_TIMEOUT_MS=20000
# TTL del ticket que autoriza a Python a consultar en nombre del usuario.
AGENT_TICKET_TTL_SECONDS=60
# Cupo de consultas por pregunta: basico (assistant:use) y avanzado (assistant:advanced).
AGENT_MAX_QUERIES_BASIC=2
AGENT_MAX_QUERIES_ADVANCED=5
AGENT_MAX_ROWS=200
# Timeout de la transaccion SQL de solo lectura que ejecuta cada consulta del DSL.
AGENT_QUERY_TIMEOUT_MS=5000

# ─── API interna del agente (segundo puerto, solo 127.0.0.1) ───────────────
# Nunca se expone: es el puerto por el que Python propone consultas del DSL.
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=3001
# IP o CIDR separados por coma. Cualquier otro origen recibe 403.
INTERNAL_ALLOWED_IPS=127.0.0.1,::1
# Limite de POST /assistant/query por usuario autenticado y RATE_LIMIT_WINDOW_MS.
ASSISTANT_RATE_LIMIT_MAX=10
# Limite del puerto interno, por IP (ahi no hay usuario autenticado).
INTERNAL_RATE_LIMIT_MAX=120

# ─── Umbrales del motor de alertas ──────────────────────────────────────────
# Dias de inventario restantes para disparar LOW_STOCK (WARNING / CRITICAL).
ALERT_LOW_STOCK_DAYS=7
ALERT_CRITICAL_STOCK_DAYS=3
# % de ocupacion para HIGH_OCCUPANCY (WARNING / CRITICAL).
ALERT_OCCUPANCY_PCT=85
ALERT_CRITICAL_OCCUPANCY_PCT=95
# Minutos de espera en triage para LONG_WAIT (CRITICAL = 2x este valor).
ALERT_WAIT_MINUTES=60
# % de variacion de demanda para DEMAND_SPIKE.
ALERT_DEMAND_SPIKE_PCT=30
# % de cancelaciones de cirugia para SURGERY_CANCELLATIONS.
ALERT_SURGERY_CANCELLATION_PCT=15
# Job que evalua el motor de alertas al arrancar y cada N minutos. En tests
# se pone en false: el motor se ejercita a mano con POST /alerts/evaluate.
ALERT_EVAL_ENABLED=true
ALERT_EVAL_INTERVAL_MINUTES=15

# ─── Imports CSV por API ─────────────────────────────────────────────────────
# Tamaño maximo (MB) de un archivo subido a POST /imports/:table. Por encima,
# 413 PAYLOAD_TOO_LARGE.
IMPORT_MAX_MB=200

# ─── Documentacion (/api/v1/docs) ────────────────────────────────────────────
# Pagina Scalar (HTML) sobre openapi.json. Por defecto true, EXCEPTO en
# produccion, donde por defecto es false salvo que se active aqui a mano.
DOCS_ENABLED=true
