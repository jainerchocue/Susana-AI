# URL base del backend real (autoridad de auth vía Better Auth, RBAC, datos y auditoria).
# Debe incluir el prefijo /api/v1. El frontend NUNCA llama directamente a la
# base de datos, al proveedor de IA ni al servicio Python del agente.
# En dev local contra el backend: http://localhost:3100/api/v1 (o el puerto que uses).
VITE_API_BASE_URL=http://localhost:3100/api/v1
