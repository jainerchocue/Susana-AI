{
  "name": "hospital-intelligence-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Hospital Intelligence: API Gateway/BFF en Node + Express + TypeScript + Zod + Prisma + PostgreSQL, con RBAC, autenticacion por credenciales (Better Auth) y mediacion de un asistente IA sin autoridad propia.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc -p tsconfig.seed.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:real": "REAL_DATA=1 vitest run tests/real-data",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "data:import": "tsx src/scripts/import-data.ts",
    "agent:mock": "node scripts/agent-mock.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node dist/prisma/seed.js",
    "db:seed:dev": "tsx prisma/seed.ts",
    "db:purge": "node dist/scripts/purge.js",
    "db:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "better-auth": "^1.7.4",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "prisma": "^6.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@vitest/mocker": "^4.1.11"
  }
}
